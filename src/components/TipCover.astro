---
interface Props {
  category: string;
  size?: 'card' | 'hero';
}
const { category, size = 'card' } = Astro.props;

// Peta kategori -> tema warna, ikon, dan huruf watermark. Kalau ada
// kategori baru yang belum terdaftar di sini, otomatis jatuh ke tema
// "default" (nggak akan error).
const themes: Record<string, { from: string; to: string; icon: string; letter: string }> = {
  'Laptop': { from: '#1B2E4B', to: '#2F4A73', icon: 'laptop', letter: 'L' },
  'HP': { from: '#3A2E1B', to: '#6B4F1E', icon: 'phone', letter: 'H' },
  'Printer': { from: '#1B3A2E', to: '#2F6B4A', icon: 'printer', letter: 'P' },
  'Aksesoris': { from: '#2E1B3A', to: '#4F2F6B', icon: 'chip', letter: 'A' },
  'Tips Beli': { from: '#3A1B1E', to: '#6B2F35', icon: 'cart', letter: 'B' },
  'Tips Perawatan': { from: '#1B3A3A', to: '#2F6B6B', icon: 'care', letter: 'T' },
};
const theme = themes[category] ?? { from: '#1B2E4B', to: '#2F4A73', icon: 'laptop', letter: category.charAt(0) };
const uid = `${size}-${theme.icon}-${Math.random().toString(36).slice(2, 8)}`;
---
<div class={`tip-cover tip-cover-${size}`} style={`background: linear-gradient(135deg, ${theme.from}, ${theme.to});`}>
  <svg viewBox="0 0 320 200" class="tip-cover-svg" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <pattern id={`grid-${uid}`} width="18" height="18" patternUnits="userSpaceOnUse">
        <path d="M18 0H0V18" fill="none" stroke="#FFFFFF" stroke-width="0.6" opacity="0.06" />
      </pattern>
      <radialGradient id={`glow-${uid}`} cx="50%" cy="45%" r="55%">
        <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.16" />
        <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect x="0" y="0" width="320" height="200" fill={`url(#grid-${uid})`} />
    <circle cx="160" cy="90" r="120" fill={`url(#glow-${uid})`} />

    <text x="300" y="185" text-anchor="end" font-family="'Roboto Slab', serif" font-size="150" fill="#FFFFFF" opacity="0.07">{theme.letter}</text>

    <circle cx="160" cy="96" r="46" fill="#FFFFFF" opacity="0.08" />
    <circle cx="160" cy="96" r="46" fill="none" stroke="#C9A84C" stroke-width="1.5" opacity="0.5" />

    <g transform="translate(160 96)">
      {theme.icon === 'laptop' && (
        <g fill="none" stroke="#C9A84C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="-24" y="-18" width="48" height="30" rx="3" />
          <rect x="-24" y="-18" width="48" height="30" rx="3" fill="#C9A84C" opacity="0.12" stroke="none" />
          <path d="M-32 18h64l-4.5 7h-55z" />
          <path d="M-9 12h18" />
        </g>
      )}
      {theme.icon === 'phone' && (
        <g fill="none" stroke="#C9A84C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="-15" y="-30" width="30" height="60" rx="6" />
          <rect x="-15" y="-30" width="30" height="60" rx="6" fill="#C9A84C" opacity="0.12" stroke="none" />
          <path d="M-6 24h12" />
          <path d="M-6 -30h12" stroke-width="4" />
        </g>
      )}
      {theme.icon === 'printer' && (
        <g fill="none" stroke="#C9A84C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="-22" y="-8" width="44" height="22" rx="3" />
          <rect x="-22" y="-8" width="44" height="22" rx="3" fill="#C9A84C" opacity="0.12" stroke="none" />
          <path d="M-14 -8v-13h28v13" />
          <rect x="-11" y="14" width="22" height="17" rx="2" />
          <circle cx="14" cy="2" r="2" fill="#C9A84C" stroke="none" />
        </g>
      )}
      {theme.icon === 'chip' && (
        <g fill="none" stroke="#C9A84C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="-16" y="-16" width="32" height="32" rx="3" />
          <rect x="-16" y="-16" width="32" height="32" rx="3" fill="#C9A84C" opacity="0.12" stroke="none" />
          <circle cx="0" cy="0" r="6" fill="#C9A84C" stroke="none" />
          <path d="M-6 -16v-8M6 -16v-8M-6 16v8M6 16v8M-16 -6h-8M-16 6h-8M16 -6h8M16 6h8" />
        </g>
      )}
      {theme.icon === 'cart' && (
        <g fill="none" stroke="#C9A84C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M-24 -20h9l9 34h28l6-24H-9" />
          <path d="M-24 -20h9l9 34h28l6-24H-9" fill="#C9A84C" opacity="0.12" stroke="none" />
          <circle cx="-4" cy="24" r="4" fill="#C9A84C" stroke="none" />
          <circle cx="18" cy="24" r="4" fill="#C9A84C" stroke="none" />
        </g>
      )}
      {theme.icon === 'care' && (
        <g fill="none" stroke="#C9A84C" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M0 26S-24 10 -24 -8a13 13 0 0122-8 13 13 0 0122 8c0 18-22 34-22 34z" fill="#C9A84C" opacity="0.14" />
          <path d="M-10 -6l5 5 8-10" stroke-width="3" />
        </g>
      )}
    </g>
  </svg>
</div>

<style>
  .tip-cover {
    position: relative;
    overflow: hidden;
  }
  .tip-cover-card { aspect-ratio: 16 / 10; border-radius: 14px 14px 0 0; }
  .tip-cover-hero { aspect-ratio: 21 / 9; border-radius: 16px; }
  .tip-cover-svg { display: block; width: 100%; height: 100%; }
</style>
