---
interface Props {
  category: string;
  size?: 'card' | 'hero';
}
const { category, size = 'card' } = Astro.props;

// Peta kategori -> tema warna & ikon. Kalau ada kategori baru yang belum
// terdaftar di sini, otomatis jatuh ke tema "default" (nggak akan error).
const themes: Record<string, { from: string; to: string; icon: string }> = {
  'Laptop': { from: '#1B2E4B', to: '#2F4A73', icon: 'laptop' },
  'HP': { from: '#3A2E1B', to: '#6B4F1E', icon: 'phone' },
  'Printer': { from: '#1B3A2E', to: '#2F6B4A', icon: 'printer' },
  'Aksesoris': { from: '#2E1B3A', to: '#4F2F6B', icon: 'chip' },
  'Tips Beli': { from: '#3A1B1E', to: '#6B2F35', icon: 'cart' },
  'Tips Perawatan': { from: '#1B3A3A', to: '#2F6B6B', icon: 'care' },
};
const theme = themes[category] ?? { from: '#1B2E4B', to: '#2F4A73', icon: 'laptop' };
const iconId = `tc-${size}-${theme.icon}-${Math.random().toString(36).slice(2, 8)}`;
---
<div class={`tip-cover tip-cover-${size}`} style={`background: linear-gradient(135deg, ${theme.from}, ${theme.to});`}>
  <svg viewBox="0 0 120 120" class="tip-cover-icon" aria-hidden="true">
    <defs>
      <clipPath id={iconId}><rect x="0" y="0" width="120" height="120" rx="16" /></clipPath>
    </defs>
    {theme.icon === 'laptop' && (
      <g fill="none" stroke="#C9A84C" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
        <rect x="28" y="34" width="64" height="42" rx="4" />
        <path d="M18 84h84l-6 10H24z" />
        <path d="M50 76h20" />
      </g>
    )}
    {theme.icon === 'phone' && (
      <g fill="none" stroke="#C9A84C" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
        <rect x="40" y="20" width="40" height="80" rx="8" />
        <path d="M55 88h10" />
      </g>
    )}
    {theme.icon === 'printer' && (
      <g fill="none" stroke="#C9A84C" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
        <rect x="30" y="46" width="60" height="30" rx="4" />
        <path d="M38 46V28h44v18" />
        <rect x="40" y="76" width="40" height="24" rx="2" />
        <circle cx="78" cy="58" r="2.5" fill="#C9A84C" stroke="none" />
      </g>
    )}
    {theme.icon === 'chip' && (
      <g fill="none" stroke="#C9A84C" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
        <rect x="38" y="38" width="44" height="44" rx="4" />
        <path d="M50 38v-8M70 38v-8M50 90v-8M70 90v-8M38 50h-8M38 70h-8M90 50h-8M90 70h-8" />
      </g>
    )}
    {theme.icon === 'cart' && (
      <g fill="none" stroke="#C9A84C" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M26 32h10l10 46h38l8-32H44" />
        <circle cx="52" cy="90" r="4" fill="#C9A84C" stroke="none" />
        <circle cx="80" cy="90" r="4" fill="#C9A84C" stroke="none" />
      </g>
    )}
    {theme.icon === 'care' && (
      <g fill="none" stroke="#C9A84C" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M60 92S32 74 32 52a16 16 0 0128-10 16 16 0 0128 10c0 22-28 40-28 40z" />
      </g>
    )}
  </svg>
</div>

<style>
  .tip-cover {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .tip-cover-card { aspect-ratio: 16 / 10; border-radius: 14px 14px 0 0; }
  .tip-cover-hero { aspect-ratio: 21 / 9; border-radius: 16px; }
  .tip-cover-icon { width: 34%; height: 34%; opacity: 0.9; }
</style>
