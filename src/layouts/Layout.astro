---
export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  schemas?: object[];
}
const {
  title,
  description,
  canonical,
  ogImage = 'https://plandemicspace.my.id/img/og/og-image.png',
  schemas = [],
} = Astro.props;
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="google-site-verification" content="ctXkL6KuBMznNHbs9jCUApY6yQh5nB_k7ubTmcG5HVM" />
  <meta name="google-site-verification" content="1G2MEXUv7S4VPi795e3nMV6lOMQfOkjBnt6NgPFVcyI" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" type="image/x-icon" href="/img/site/favicon.ico">
  <link rel="icon" type="image/png" sizes="16x16" href="/img/site/favicon-16.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/img/site/favicon-32.png">
  <link rel="apple-touch-icon" href="/img/site/apple-touch-icon.png">
  <link rel="canonical" href={canonical}>

  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="id_ID">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/style.css">

  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body>
  <slot />
  <script src="/js/main.js" is:inline></script>
</body>
</html>
