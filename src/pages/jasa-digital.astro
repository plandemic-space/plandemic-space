  <!-- HASIL KERJA KAMI -->
  <section class="jd-portfolio" id="hasil-kerja">
    <div class="jd-portfolio-inner">
      <div class="sec-label">HASIL KERJA KAMI</div>
      <h2 class="sec-title">Dikerjakan beneran, bukan mock-up.</h2>

      <div class="jd-pf-group">
        <div class="jd-pf-label">UNTUK USAHA (UMKM)</div>
        <div class="jd-pf-items">
          <a class="jd-pf-item" href="https://khanzabibit.vercel.app" target="_blank" rel="noopener">
            <div class="jd-pf-preview"><iframe src="https://khanzabibit.vercel.app" loading="lazy" title="Preview situs Khanza Bibit" tabindex="-1"></iframe></div>
