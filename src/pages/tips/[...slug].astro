---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TipCover from '../../components/TipCover.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allTips = await getCollection('tips');
  return allTips.map((tip) => ({
    params: { slug: tip.slug },
    props: { tip },
  }));
}

const { tip } = Astro.props;
const { Content } = await tip.render();

const formattedDate = tip.data.pubDate.toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const pageUrl = `https://plandemicspace.my.id/tips/${tip.slug}`;
const isoDate = tip.data.pubDate.toISOString();

// Artikel terkait: kategori sama, bukan artikel ini sendiri, ambil 3 terbaru
const allTips = await getCollection('tips');
const related = allTips
  .filter((t) => t.slug !== tip.slug && t.data.category === tip.data.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const shareText = encodeURIComponent(tip.data.title);
const shareUrl = encodeURIComponent(pageUrl);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: tip.data.title,
  description: tip.data.description,
  datePublished: isoDate,
  dateModified: isoDate,
  author: {
    '@type': 'Organization',
    name: 'Plandemic Space',
    url: 'https://plandemicspace.my.id/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Plandemic Space',
    logo: {
      '@type': 'ImageObject',
      url: 'https://plandemicspace.my.id/img/site/logo-512-whitebg.png',
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
  articleSection: tip.data.category,
  keywords: tip.data.tags.join(', '),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://plandemicspace.my.id/' },
    { '@type': 'ListItem', position: 2, name: 'Tips', item: 'https://plandemicspace.my.id/tips' },
    { '@type': 'ListItem', position: 3, name: tip.data.title, item: pageUrl },
  ],
};
---
<Layout
  title={`${tip.data.title} | Plandemic Space`}
  description={tip.data.description}
  canonical={pageUrl}
  schemas={[articleSchema, breadcrumbSchema]}
>
  <SiteNav />
  <main>
    <article class="tip-article">
      <div class="tip-article-inner">
        <a href="/tips" class="tip-back">← Semua Tips</a>

        <div class="tip-cover-wrap">
          <TipCover category={tip.data.category} size="hero" />
        </div>

        <span class="tip-cat">{tip.data.category}</span>
        <h1>{tip.data.title}</h1>
        <p class="tip-date">{formattedDate}</p>

        <div class="tip-body">
          <Content />
        </div>

        <div class="tip-share">
          <span class="tip-share-label">Bagikan:</span>
          <a class="tip-share-btn tip-share-wa" href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener" aria-label="Bagikan ke WhatsApp">WhatsApp</a>
          <a class="tip-share-btn tip-share-fb" href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener" aria-label="Bagikan ke Facebook">Facebook</a>
          <a class="tip-share-btn tip-share-x" href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener" aria-label="Bagikan ke X/Twitter">X</a>
          <button type="button" class="tip-share-btn tip-copy" data-url={pageUrl}>Salin Link</button>
        </div>

        {related.length > 0 && (
          <div class="tip-related">
            <h2 class="tip-related-title">Tips lain di kategori {tip.data.category}</h2>
            <div class="tip-related-grid">
              {related.map((r) => (
                <a class="tip-related-card" href={`/tips/${r.slug}`}>
                  <TipCover category={r.data.category} size="card" />
                  <div class="tip-related-body">
                    <h3>{r.data.title}</h3>
                    <p>{r.data.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </article>
  </main>
  <SiteFooter />
</Layout>

<script>
  const copyBtn = document.querySelector<HTMLButtonElement>('.tip-copy');
  copyBtn?.addEventListener('click', async () => {
    const url = copyBtn.dataset.url ?? '';
    try {
      await navigator.clipboard.writeText(url);
      const original = copyBtn.textContent;
      copyBtn.textContent = 'Tersalin!';
      setTimeout(() => { copyBtn.textContent = original; }, 1800);
    } catch {
      // Clipboard API gagal (browser lama/HTTP) — biarkan teks tombol apa adanya.
    }
  });

  // Tambahin tombol "Salin" otomatis di tiap blok kode (perintah/command) dalam artikel.
  document.querySelectorAll<HTMLPreElement>('.tip-body pre').forEach((pre) => {
    const codeEl = pre.querySelector('code');
    if (!codeEl) return;

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-code-btn';
    btn.textContent = 'Salin';
    pre.appendChild(btn);

    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(codeEl.textContent ?? '');
        btn.textContent = 'Tersalin!';
        setTimeout(() => { btn.textContent = 'Salin'; }, 1800);
      } catch {
        // Clipboard API gagal (browser lama/HTTP) — biarkan teks tombol apa adanya.
      }
    });
  });
</script>

<style>
  .tip-article { padding: 7rem 1.5rem 5rem; }
  .tip-article-inner { max-width: 680px; margin: 0 auto; }
  .tip-back {
    display: inline-block;
    font-size: 0.9rem;
    color: var(--navy-mid);
    text-decoration: none;
    margin-bottom: 1.5rem;
  }
  .tip-cover-wrap { margin-bottom: 1.5rem; }
  .tip-cat {
    display: inline-block;
    font-family: 'Rajdhani', sans-serif;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--gold-dim);
    background: rgba(201, 168, 76, 0.12);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }
  .tip-article-inner h1 {
    font-family: 'DM Serif Display', serif;
    font-weight: 400;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.3;
    margin: 0.5rem 0 0.5rem;
    color: var(--navy);
  }
  .tip-date { color: var(--muted); font-size: 0.9rem; margin-bottom: 2rem; }
  .tip-body {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #2D2D2D;
  }
  .tip-body :global(h2) {
    font-family: 'DM Serif Display', serif;
    font-weight: 400;
    font-size: 1.3rem;
    margin: 2rem 0 0.75rem;
    color: var(--navy);
    padding-bottom: 0.5rem;
    border-bottom: 1px dashed rgba(200, 223, 232, 0.9);
  }
  .tip-body :global(p) { margin-bottom: 1.1rem; }
  .tip-body :global(ul) {
    list-style: none;
    margin: 0 0 1.1rem;
    padding: 0;
  }
  .tip-body :global(ul li) {
    position: relative;
    padding-left: 1.3rem;
    margin-bottom: 0.5rem;
  }
  .tip-body :global(ul li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--gold-dim);
  }
  .tip-body :global(ol) {
    list-style: none;
    counter-reset: tip-steps;
    margin: 0 0 1.1rem;
    padding: 0;
  }
  .tip-body :global(ol li) {
    counter-increment: tip-steps;
    position: relative;
    padding-left: 2.5rem;
    margin-bottom: 0.7rem;
    min-height: 1.7rem;
  }
  .tip-body :global(ol li::before) {
    content: counter(tip-steps);
    position: absolute;
    left: 0;
    top: 0;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    background: var(--navy);
    color: var(--white);
    font-family: 'Rajdhani', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .tip-body :global(hr) {
    border: none;
    border-top: 1px solid rgba(200, 223, 232, 0.8);
    margin: 2rem 0;
  }
  .tip-body :global(a) {
    color: var(--navy-mid);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(36, 61, 99, 0.35);
    text-underline-offset: 2px;
  }
  .tip-body :global(a:hover) { text-decoration-color: var(--navy-mid); }
  .tip-body :global(strong) { color: var(--ink); font-weight: 700; }

  .tip-body :global(code) {
    font-family: 'JetBrains Mono', 'Fira Code', Consolas, monospace;
    font-size: 0.88em;
    background: rgba(200, 223, 232, 0.35);
    color: var(--navy);
    padding: 0.15em 0.4em;
    border-radius: 5px;
  }
  .tip-body :global(pre) {
    position: relative;
    background: var(--navy) !important;
    color: var(--pastel-light) !important;
    padding: 1.1rem 1.1rem;
    padding-right: 3.2rem;
    border-radius: 10px;
    overflow-x: auto;
    margin: 0 0 1.3rem;
  }
  .tip-body :global(pre code) {
    background: none !important;
    color: inherit !important;
    padding: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    white-space: pre;
  }
  .tip-body :global(pre code .line span) { color: inherit !important; }
  .tip-body :global(pre .copy-code-btn) {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--pastel-light);
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .tip-body :global(pre .copy-code-btn:hover) { background: rgba(255, 255, 255, 0.22); }

  .tip-share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(200, 223, 232, 0.8);
  }
  .tip-share-label {
    font-family: 'Rajdhani', sans-serif;
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--navy-mid);
    margin-right: 0.25rem;
  }
  .tip-share-btn {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(200, 223, 232, 0.8);
    background: var(--white);
    color: var(--navy-mid);
    text-decoration: none;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .tip-share-btn:hover { border-color: var(--gold-dim); color: var(--navy); }
  .tip-share-wa { background: #25D366; border-color: #25D366; color: #FFFFFF; }
  .tip-share-wa:hover { background: #1EBE5A; border-color: #1EBE5A; color: #FFFFFF; }
  .tip-share-fb { background: #1877F2; border-color: #1877F2; color: #FFFFFF; }
  .tip-share-fb:hover { background: #0F5FCC; border-color: #0F5FCC; color: #FFFFFF; }
  .tip-share-x { background: #000000; border-color: #000000; color: #FFFFFF; }
  .tip-share-x:hover { background: #2A2A2A; border-color: #2A2A2A; color: #FFFFFF; }

  .tip-related { margin-top: 3rem; }
  .tip-related-title {
    font-family: 'DM Serif Display', serif;
    font-weight: 400;
    font-size: 1.15rem;
    color: var(--navy);
    margin-bottom: 1.2rem;
  }
  .tip-related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 260px));
    gap: 1.1rem;
  }
  .tip-related-card {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    border: 1px solid rgba(200, 223, 232, 0.6);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .tip-related-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(27, 46, 75, 0.08);
  }
  .tip-related-body { padding: 0.9rem 1rem 1.1rem; }
  .tip-related-body h3 {
    font-family: 'DM Serif Display', serif;
    font-weight: 400;
    font-size: 0.98rem;
    line-height: 1.35;
    margin-bottom: 0.4rem;
  }
  .tip-related-body p {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.5;
  }
</style>
